<%- include('partials/header') %>

<div class="icds-hero">
    <h1>What hymn would you like to display?</h1>
    <p>Say a hymn number or title — recognized in real time.</p>
</div>

<div class="icds-voice-panel">
    <div id="listen-btn" class="icds-mic-btn">
        <i data-lucide="mic"></i>
    </div>
    
    <input type="text" id="transcript-display" class="icds-transcript-area" placeholder="Type or say a hymn number, title, or lyrics..." autocomplete="off" style="border: none; background: transparent; outline: none; width: 100%; color: inherit; font: inherit;">
    
    <button id="submit-btn" class="icds-submit-btn">
        <i data-lucide="send"></i>
    </button>
</div>

<!-- Feedback hidden by default, shown via JS if error/success -->
<div id="feedback-display" class="icds-feedback text-center mb-4" style="display: none;"></div>

<!-- Inline Hymn Display (User requested same tab display) -->
<div id="inline-hymn-display" style="display: none; background-color: var(--icds-card-bg); border: 1px solid var(--icds-border); border-radius: 16px; padding: 30px; margin-bottom: 40px; text-align: center;">
    <h2 id="inline-hymn-title" style="font-size: clamp(1.5rem, 3vw, 3rem); font-weight: 900; margin-bottom: 20px; color: var(--icds-text);"></h2>
    <div id="inline-hymn-lyrics" style="font-size: clamp(1.2rem, 2.5vw, 2.5rem); font-weight: 600; line-height: 1.5; color: var(--icds-text); white-space: normal;"></div>
    
    <div style="margin-top: 30px; display: flex; justify-content: center; gap: 20px;">
        <button id="inline-btn-prev" class="btn btn-outline-secondary px-4 fw-bold" style="display: none;">&larr; Previous Verse</button>
        <button id="inline-btn-next" class="btn btn-outline-primary px-4 fw-bold" style="display: none;">Next Verse &rarr;</button>
        <button id="inline-btn-fullscreen" class="btn btn-outline-info px-4 fw-bold" style="display: none;"><i data-lucide="maximize"></i> Fullscreen Mode</button>
    </div>
</div>

<div class="d-flex justify-content-center mb-4">
    <button id="btn-detect-hdmi" class="btn btn-outline-info d-flex align-items-center gap-2 fw-bold" style="border-radius: 8px;">
        <i data-lucide="monitor-up"></i> Enable HDMI / Projector Auto-Display
    </button>
</div>

<div class="icds-quick-actions-container">
    <% if (recentLogs && recentLogs.length > 0) { %>
        <div class="icds-quick-actions-grid">
            <% recentLogs.forEach(log => { %>
                <div class="icds-quick-card" onclick="submitCommand('<%= log.Title.replace(/'/g, "\\'") %>')">
                    <i data-lucide="monitor-speaker" class="icds-quick-card-icon"></i>
                    <div class="icds-quick-card-title">Hymn <%= log.HymnNumber %></div>
                    <div class="icds-quick-card-subtitle"><%= log.Title %></div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="icds-empty-state">
            <i data-lucide="inbox" style="width: 32px; height: 32px; margin-bottom: 15px; opacity: 0.5;"></i>
            <p>No recently displayed hymns.</p>
        </div>
    <% } %>
</div>

<!-- Send a hidden script variable for the script -->
<script>
    function submitCommand(text) {
        if (window.sendVoiceCommand) {
            window.sendVoiceCommand(text, 1.0); // 1.0 confidence since it's manual
        }
    }
</script>
<script src="/js/operator.js"></script>

<%- include('partials/footer') %>

<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold text-white mb-2">Welcome Back, Admin</h2>
        <p class="text-muted">Intelligent Content Display System Administration</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100 p-2">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                <i data-lucide="library" style="width: 48px; height: 48px; color: var(--icds-primary); margin-bottom: 15px;"></i>
                <h1 class="display-5 fw-bold text-white"><%= hymnCount %></h1>
                <h5 class="text-muted mb-0">Total Hymns</h5>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pb-4">
                <a href="/admin/hymns" class="btn btn-outline-primary px-4 fw-bold">Manage Hymns</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mb-4">
        <div class="card h-100 p-2">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                <i data-lucide="activity" style="width: 48px; height: 48px; color: var(--icds-primary); margin-bottom: 15px;"></i>
                <h1 class="display-5 fw-bold text-white"><%= logCount %></h1>
                <h5 class="text-muted mb-0">Commands Processed</h5>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pb-4">
                <a href="/admin/logs" class="btn btn-outline-primary px-4 fw-bold">View Logs</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 text-white"><i data-lucide="monitor-speaker" class="me-2" style="width:20px;height:20px;color:var(--icds-primary);"></i> System Quick Links</h5>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/operator" target="_blank" class="btn btn-outline-primary d-flex align-items-center gap-2 fw-bold">
                        <i data-lucide="mic"></i> Open Operator Interface
                    </a>
                    <a href="/display" target="_blank" class="btn btn-outline-secondary d-flex align-items-center gap-2 fw-bold text-white border-secondary">
                        <i data-lucide="cast"></i> Open Projection Display
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-white">Manage Hymns</h2>
    <button class="btn btn-primary d-flex align-items-center gap-2 fw-bold" data-bs-toggle="modal" data-bs-target="#addHymnModal">
        <i data-lucide="plus-circle" width="18"></i> Add New Hymn
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Number</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (hymns.length === 0) { %>
                        <tr>
                            <td colspan="4" class="text-center p-5 text-muted">
                                <i data-lucide="inbox" style="width: 48px; height: 48px; opacity: 0.5; margin-bottom: 15px;"></i>
                                <p class="mb-0">No hymns found in the database.</p>
                            </td>
                        </tr>
                    <% } %>
                    <% hymns.forEach(hymn => { %>
                        <tr>
                            <td class="ps-4 fw-bold" style="color: var(--icds-primary);">#<%= hymn.HymnNumber %></td>
                            <td class="fw-semibold text-white"><%= hymn.Title %></td>
                            <td><span class="badge" style="background-color: rgba(255,255,255,0.1); color: var(--icds-text-muted);"><%= hymn.Category || 'Uncategorized' %></span></td>
                            <td class="text-end pe-4">
                                <form action="/admin/hymns/delete/<%= hymn.HymnID %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this hymn?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold d-inline-flex align-items-center gap-1">
                                        <i data-lucide="trash-2" width="14"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Hymn Modal -->
<div class="modal fade" id="addHymnModal" tabindex="-1" aria-labelledby="addHymnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-white" id="addHymnModalLabel">Add New Hymn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/hymns/create" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="HymnNumber" class="form-label text-muted fw-semibold">Hymn Number (001-999)</label>
                        <input type="number" class="form-control" id="HymnNumber" name="HymnNumber" min="1" max="999" required>
                    </div>
                    <div class="mb-3">
                        <label for="Title" class="form-label text-muted fw-semibold">Title</label>
                        <input type="text" class="form-control" id="Title" name="Title" maxlength="100" required>
                    </div>
                    <div class="mb-3">
                        <label for="Category" class="form-label text-muted fw-semibold">Category</label>
                        <input type="text" class="form-control" id="Category" name="Category" maxlength="30">
                    </div>
                    <div class="mb-3">
                        <label for="Lyrics" class="form-label text-muted fw-semibold">Lyrics</label>
                        <textarea class="form-control" id="Lyrics" name="Lyrics" rows="5" maxlength="2000" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn fw-bold" style="color: var(--icds-text);" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Save Hymn</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
